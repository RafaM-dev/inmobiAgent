##############################################################################
# AgentInmobi — configuración de entorno
#
# MODO DEMO: copia este archivo a `.env` y arranca. Los valores por defecto
# levantan el producto completo SIN NINGUNA API KEY.
#   cp .env.example .env
##############################################################################

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
APP_NAME=agentinmobi
APP_VERSION=0.1.0
LOG_LEVEL=debug
# Formatea los logs para humanos en desarrollo. En producción: false (JSON).
LOG_PRETTY=true

# --- HTTP -------------------------------------------------------------------
HTTP_HOST=0.0.0.0
# 3000 suele estar ocupado por otros proyectos; 3100 evita el choque.
HTTP_PORT=3100
# Orígenes permitidos para el back-office (separados por coma).
CORS_ORIGINS=http://localhost:5173

# --- Base de datos ----------------------------------------------------------
# El rol de la APLICACIÓN. No es superusuario, y eso es lo que hace que Row
# Level Security proteja algo: un superusuario se salta todas las políticas.
# Lo crea `pnpm db:provision`, que corre solo antes de cada migración.
DATABASE_URL=postgresql://agentinmobi_app:agentinmobi_app@localhost:5433/agentinmobi?schema=public

# El superusuario del contenedor. Solo se usa para crear extensiones y
# provisionar el rol de arriba; la aplicación nunca se conecta con él.
DATABASE_ADMIN_URL=postgresql://agentinmobi:agentinmobi@localhost:5433/agentinmobi?schema=public

# --- Proveedores intercambiables (aquí vive el MODO DEMO) -------------------
# mock | openai | anthropic | gemini | ollama
LLM_PROVIDER=mock
# mock | openai | ollama
EMBEDDING_PROVIDER=mock
# mock | http
PROPERTY_PROVIDER=mock
# memory | postgres  (almacenamiento de vectores)
VECTOR_STORE=postgres

# Solo se leen si el provider correspondiente está activo. Vacíos en modo demo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Modelo concreto. Vacío = el que traiga el adaptador, que siempre es uno
# vigente. OPENAI_MODEL no tiene valor por defecto a propósito: elegirlo por ti
# sería decidir tu factura.
ANTHROPIC_MODEL=
OPENAI_MODEL=
OLLAMA_MODEL=llama3.1

# Profundidad de razonamiento: low | medium | high | xhigh | max.
# `low` porque el agente responde por WhatsApp —la latencia se nota— y las
# decisiones que importan (intención, escalamiento, fechas, precios) las toman
# políticas deterministas, no el modelo. Solo lo usa Anthropic.
LLM_EFFORT=low
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# --- Agente -----------------------------------------------------------------
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_TURN_TIMEOUT_MS=45000
# Espera de silencio antes de procesar un turno (agrupa mensajes seguidos).
AGENT_TURN_DEBOUNCE_MS=2500
AGENT_TURN_DEBOUNCE_MAX_MS=8000

# --- Seguridad --------------------------------------------------------------
# Clave de 32 bytes en base64 para cifrar credenciales de canal.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGV2LW9ubHktcGxhY2Vob2xkZXIta2V5LTMyYnl0ZXM=

# --- WhatsApp Cloud API -----------------------------------------------------
# Sin estos dos valores el canal NO se registra y el producto funciona entero
# por consola. Son de la APP de Meta (una para toda la plataforma); el token de
# acceso de cada número va cifrado en su cuenta de canal, no aquí.
WHATSAPP_APP_SECRET=dev-app-secret-solo-para-pruebas
WHATSAPP_VERIFY_TOKEN=dev-verify-token-solo-para-pruebas
# Apúntalo a un doble local para probar sin cuenta real.
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=10000

# --- Almacenamiento y conocimiento -----------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=.storage
KNOWLEDGE_MAX_DOCUMENT_BYTES=5242880

# Tope de gasto en IA por inmobiliaria y mes, en USD. Cada inmobiliaria puede
# fijar el suyo desde el panel; este es el valor por defecto.
# CERO SIGNIFICA SIN TOPE, no "no gastes nada": a quien se le olvida
# configurarlo no se le puede apagar el agente. Al alcanzarlo, las
# conversaciones pasan a un asesor en vez de quedarse sin respuesta.
TENANT_MONTHLY_BUDGET_USD=0

# Límites de RITMO por inmobiliaria. Complementan al tope de gasto: aquél acota
# la factura del mes, éstos acotan el daño que un bucle roto o un abuso pueden
# hacer en los próximos sesenta segundos —antes de que llegue a ser factura.
# CERO SIGNIFICA SIN LÍMITE, igual que arriba.
#
# `BURST` es la ráfaga que se tolera de golpe; `PER_MINUTE`, el ritmo sostenido
# al que se repone. Un proveedor de canal entrega un lote y luego gotea: eso
# pasa. Un bucle martillea sin parar: eso se corta.
#
# Mensajes entrantes por inmobiliaria. Protege el proceso y la base de datos.
# Al superarlo se responde 429 con `Retry-After`, así que el proveedor
# reintenta: el mensaje del cliente se aplaza, no se pierde.
RATE_LIMIT_TENANT_MESSAGES_PER_MINUTE=120
RATE_LIMIT_TENANT_MESSAGES_BURST=240
# Turnos del agente por contacto. Protege la factura de IA y el buzón del
# asesor. Las ráfagas cortas ya las une el debounce de turnos, así que esto
# corta lo sostenido: un número que insiste durante horas.
RATE_LIMIT_CONTACT_TURNS_PER_MINUTE=12
RATE_LIMIT_CONTACT_TURNS_BURST=20

# --- Observabilidad ---------------------------------------------------------
# `GET /metrics` en formato Prometheus: tráfico, latencias, turnos por
# desenlace, coste acumulado, retraso del outbox y qué versión corre.
#
# El endpoint cuenta cómo va el sistema por dentro, así que no es público.
# EN PRODUCCIÓN, SIN TOKEN LA RUTA NO SE REGISTRA y el arranque lo avisa: falla
# cerrada. En desarrollo está abierta, que es lo que hace útil un `curl`.
#   curl -s localhost:3000/metrics | grep agentinmobi_agent_turns
METRICS_ENABLED=true
# Mínimo 16 caracteres. Se envía como `Authorization: Bearer <token>`.
# METRICS_TOKEN=
