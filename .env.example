##############################################################################
# AgentInmobi — configuración de entorno
#
# MODO DEMO: copia este archivo a `.env` y arranca. Los valores por defecto
# levantan el producto completo SIN NINGUNA API KEY.
#   cp .env.example .env
##############################################################################

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
APP_NAME=agentinmobi
APP_VERSION=0.1.0
LOG_LEVEL=debug
# Formatea los logs para humanos en desarrollo. En producción: false (JSON).
LOG_PRETTY=true

# --- HTTP -------------------------------------------------------------------
HTTP_HOST=0.0.0.0
# 3000 suele estar ocupado por otros proyectos; 3100 evita el choque.
HTTP_PORT=3100
# Orígenes permitidos para el back-office (separados por coma).
CORS_ORIGINS=http://localhost:5173

# --- Base de datos ----------------------------------------------------------
DATABASE_URL=postgresql://agentinmobi:agentinmobi@localhost:5433/agentinmobi?schema=public

# --- Proveedores intercambiables (aquí vive el MODO DEMO) -------------------
# mock | openai | anthropic | gemini | ollama
LLM_PROVIDER=mock
# mock | openai | ollama
EMBEDDING_PROVIDER=mock
# mock | http
PROPERTY_PROVIDER=mock
# memory | postgres  (almacenamiento de vectores)
VECTOR_STORE=postgres

# Solo se leen si el provider correspondiente está activo. Vacíos en modo demo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Modelo concreto. Vacío = el que traiga el adaptador, que siempre es uno
# vigente. OPENAI_MODEL no tiene valor por defecto a propósito: elegirlo por ti
# sería decidir tu factura.
ANTHROPIC_MODEL=
OPENAI_MODEL=
OLLAMA_MODEL=llama3.1

# Profundidad de razonamiento: low | medium | high | xhigh | max.
# `low` porque el agente responde por WhatsApp —la latencia se nota— y las
# decisiones que importan (intención, escalamiento, fechas, precios) las toman
# políticas deterministas, no el modelo. Solo lo usa Anthropic.
LLM_EFFORT=low
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# --- Agente -----------------------------------------------------------------
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_TURN_TIMEOUT_MS=45000
# Espera de silencio antes de procesar un turno (agrupa mensajes seguidos).
AGENT_TURN_DEBOUNCE_MS=2500
AGENT_TURN_DEBOUNCE_MAX_MS=8000

# --- Seguridad --------------------------------------------------------------
# Clave de 32 bytes en base64 para cifrar credenciales de canal.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGV2LW9ubHktcGxhY2Vob2xkZXIta2V5LTMyYnl0ZXM=

# --- WhatsApp Cloud API -----------------------------------------------------
# Sin estos dos valores el canal NO se registra y el producto funciona entero
# por consola. Son de la APP de Meta (una para toda la plataforma); el token de
# acceso de cada número va cifrado en su cuenta de canal, no aquí.
WHATSAPP_APP_SECRET=dev-app-secret-solo-para-pruebas
WHATSAPP_VERIFY_TOKEN=dev-verify-token-solo-para-pruebas
# Apúntalo a un doble local para probar sin cuenta real.
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=10000

# --- Almacenamiento y conocimiento -----------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=.storage
KNOWLEDGE_MAX_DOCUMENT_BYTES=5242880
