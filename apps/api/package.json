{
  "name": "@agentinmobi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/bootstrap/worker.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:seed": "tsx --env-file=../../.env prisma/seed/seed.ts",
    "chat": "tsx --env-file=../../.env scripts/chat.ts"
  },
  "dependencies": {
    "@agentinmobi/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.14.0",
    "awilix": "^12.0.5",
    "fastify": "^5.5.0",
    "pino": "^9.7.0",
    "uuid": "^11.1.0",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@agentinmobi/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.14.0",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
