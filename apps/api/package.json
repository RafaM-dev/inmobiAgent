{
  "name": "@agentinmobi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/bootstrap/worker.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "tsx --env-file=../../.env eval/cli.ts",
    "db:generate": "prisma generate",
    "db:migrate": "pnpm db:provision && prisma migrate dev && pnpm db:indexes",
    "db:deploy": "pnpm db:provision && prisma migrate deploy && pnpm db:indexes",
    "db:indexes": "tsx --env-file=../../.env scripts/ensure-search-indexes.ts",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:seed": "tsx --env-file=../../.env prisma/seed/seed.ts",
    "chat": "tsx --env-file=../../.env scripts/chat.ts",
    "db:provision": "tsx --env-file=../../.env scripts/provision-db-role.ts",
    "db:backup": "tsx --env-file=../../.env scripts/backup.ts",
    "db:verify-restore": "tsx --env-file=../../.env scripts/verify-restore.ts",
    "release": "node dist/release.js"
  },
  "dependencies": {
    "@agentinmobi/contracts": "workspace:*",
    "@anthropic-ai/sdk": "^0.116.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.14.0",
    "awilix": "^12.0.5",
    "fastify": "^5.5.0",
    "mammoth": "^1.12.1",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "pino": "^9.7.0",
    "prisma": "^6.14.0",
    "unpdf": "^1.8.0",
    "uuid": "^11.1.0",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@agentinmobi/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "pino-pretty": "^13.0.0",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
