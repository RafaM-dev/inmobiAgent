{
  "extends": "@agentinmobi/config-ts/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "eval/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts",
    "tsup.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
